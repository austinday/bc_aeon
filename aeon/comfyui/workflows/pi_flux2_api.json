{
  "1": {
    "inputs": {
        "clip_name": "mistral_3_small_flux2_fp8.safetensors",
      "type": "flux2"
    },
    "class_type": "CLIPLoader"
  },
  "2": {
    "inputs": {
      "clip": ["1", 0],
      "text": "{{PROMPT}}"
    },
    "class_type": "CLIPTextEncode"
  },
  "3": {
    "inputs": {
      "width": {{WIDTH}},
      "height": {{HEIGHT}},
      "batch_size": 1
    },
    "class_type": "EmptyFlux2LatentImage"
  },
  "4": {
    "inputs": {
        "model_name": "flux2_dev_fp8mixed.safetensors",
      "weight_dtype": "default",
      "adapter_name": "gmflux2_k8_piid_4step.safetensors",
      "adapter_strength": 1.0
    },
    "class_type": "Load pi-Flow Model"
  },
  "5": {
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "class_type": "VAELoader"
  },
  "6": {
    "inputs": {
      "model": ["4", 0],
      "shift": {{SHIFT}}
    },
    "class_type": "ModelSamplingPiFlow"
  },
  "7": {
    "inputs": {
      "conditioning": ["2", 0],
      "guidance": {{GUIDANCE}}
    },
    "class_type": "FluxGuidance"
  },
  "8": {
    "inputs": {
      "model": ["6", 0],
      "conditioning": ["7", 0],
      "latent_image": ["3", 0],
      "seed": {{SEED}},
      "steps": {{STEPS}},
      "substeps": 128,
      "final_step_size_scale": 0.5,
      "diffusion_coefficient": 0.0,
      "gm_temperature": "auto",
      "manual_gm_temperature": 1.0,
      "denoise": 1.0
    },
    "class_type": "pi-Flow Sampler"
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["5", 0]
    },
    "class_type": "VAEDecode"
  },
  "10": {
    "inputs": {
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "images": ["9", 0]
    },
    "class_type": "SaveImage"
  }
}