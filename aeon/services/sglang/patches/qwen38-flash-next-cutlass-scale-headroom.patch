+            or self.enable_flashinfer_cutlass_moe
+        ):
             layer.w2_blockscale_swizzled = None
         else:
             layer.w2_blockscale_swizzled = Parameter(
                 swizzle_blockscale(layer.w2_weight_scale), requires_grad=False
             )
