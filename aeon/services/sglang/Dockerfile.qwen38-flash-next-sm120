    && test "$(sha256sum /tmp/qwen38-flash-next-cutlass-scale-headroom.patch | cut -d' ' -f1)" = "a6c61ef9eaa1153551506b26aca7627f7ecc98851f6cd7e7038cd6d0a25b5c6a" \
    && test "$(sha256sum /tmp/qwen38-flash-next-mtp-share-before-pool.patch | cut -d' ' -f1)" = "424eb761834646089437f7e2d16694ab06f03e102f045da07f4a35aa3c83b607" \
    && test -f python/sglang/srt/models/qwen4_exp.py \
    && test -f python/sglang/srt/models/qwen4_exp_mtp.py \
    && test -f python/sglang/srt/models/qwen3_5_mtp.py \
    && test -f python/sglang/srt/layers/quantization/modelopt_quant.py \
    && test -f python/sglang/srt/speculative/eagle_worker_v2.py \
    && git apply --check \
        --include=python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py \
        /tmp/qwen38-flash-next-sm120-qsa.patch \
    && git apply \
        --include=python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py \
        /tmp/qwen38-flash-next-sm120-qsa.patch \
    && git apply --check \
        --include=python/sglang/srt/models/qwen4_exp.py \
        /tmp/qwen38-flash-next-fused-shared.patch \
    && git apply \
        --include=python/sglang/srt/models/qwen4_exp.py \
        /tmp/qwen38-flash-next-fused-shared.patch \
    && git apply --check /tmp/qwen38-flash-next-mtp-shared.patch \
    && git apply /tmp/qwen38-flash-next-mtp-shared.patch \
    && git apply --check /tmp/qwen38-flash-next-cutlass-scale-headroom.patch \
    && git apply /tmp/qwen38-flash-next-cutlass-scale-headroom.patch \
    && git apply --check /tmp/qwen38-flash-next-mtp-share-before-pool.patch \
    && git apply /tmp/qwen38-flash-next-mtp-share-before-pool.patch \
    && git diff --check \
    && python3 -m compileall -q \
        python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py \
        python/sglang/srt/layers/quantization/modelopt_quant.py \
        python/sglang/srt/models/qwen3_5_mtp.py \
        python/sglang/srt/models/qwen4_exp.py \
        python/sglang/srt/models/qwen4_exp_mtp.py \
        python/sglang/srt/speculative/eagle_worker_v2.py \
    && grep -Fq 'is_sm100_supported() or is_sm120_supported()' \
        python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py \
    && grep -Fq 'sglang.kernels.ops.attention.flash_attention_v4' \
        python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py \
    && grep -Fq '_qwen4_exp_fused_shared_expert_mapping' \
        python/sglang/srt/models/qwen4_exp.py \
    && grep -Fq 'Required MTP shared-expert parameter could not be loaded' \
        python/sglang/srt/models/qwen3_5_mtp.py \
    && test "$(grep -Fc 'or self.enable_flashinfer_cutlass_moe' \
        python/sglang/srt/layers/quantization/modelopt_quant.py)" = "2" \
    && grep -Fq 'self._lm_head_shared = True' \
        python/sglang/srt/speculative/eagle_worker_v2.py \
    && grep -Fq 'if not getattr(self, "_lm_head_shared", False):' \
        python/sglang/srt/speculative/eagle_worker_v2.py \
    && rm -f \
        /tmp/qwen38-flash-next-sm120-qsa.patch \
        /tmp/qwen38-flash-next-fused-shared.patch \
        /tmp/qwen38-flash-next-mtp-shared.patch \
        /tmp/qwen38-flash-next-cutlass-scale-headroom.patch \
        /tmp/qwen38-flash-next-mtp-share-before-pool.patch

