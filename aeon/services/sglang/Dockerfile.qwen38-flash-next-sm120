    && test "$(sha256sum /tmp/qwen38-flash-next-sm120-qsa.patch | cut -d' ' -f1)" = "eba9b1b2c07f6bdfe42502ffc50667f7e1e5467dc1ee96f0a8e791562e1c9679" \
