# =============================================================================
# DeepSeek-V4-Flash CUDA fork (Fringe210) - DEDICATED image: aeon_ds4:latest
# =============================================================================
# DeepSeek-V4-Flash uses a custom 'deepseek4' architecture (MoE + sliding-window
# attention + compressor + indexer) that STOCK/upstream llama.cpp cannot load.
#
# We clone Fringe210/llama.cpp-deepseek-v4-flash-cuda, which implements the V4
# ops (compressor, indexer, hyperconnection, sinkhorn) as CUDA kernels. The
# earlier cdome94 fork fixed only the concat crash and left those ops on the CPU,
# which produced a running-but-extremely-slow model (~11901 graph splits,
# constant CPU<->GPU copies). Fringe210 keeps the same loader lineage as antirez,
# so it loads the existing CyberNeurova GGUF unchanged (no re-download).
#
# Kept SEPARATE from aeon_llamacpp:latest (mainline models) so this experimental
# fork can't break Qwen3.6 / Gemma-4.
#
# Build:  docker build -t aeon_ds4:latest -f this/Dockerfile.ds4 .
# =============================================================================

# --- Stage 1: Build ---
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git cmake build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Fringe210's CUDA implementation of the DeepSeek-V4-Flash ops.
RUN git clone --depth 1 https://github.com/Fringe210/llama.cpp-deepseek-v4-flash-cuda.git /build/llama.cpp

WORKDIR /build/llama.cpp

# CUDA stubs for link-time (real driver injected at runtime via --gpus).
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
    && echo '/usr/local/cuda/lib64/stubs' > /etc/ld.so.conf.d/cuda-stubs.conf \
    && ldconfig

# 89=Ada, 90=Hopper, 120=Blackwell. V4's native FP8 path is gated on SM>=89.
# GGML_SCHED_MAX_SPLIT_INPUTS=128: V4's dense per-layer inputs (hyperconnection +
# indexer + multiple KV caches) exceed the scheduler's default 30-input limit at
# multi-GPU split boundaries; mandatory here since the model needs both cards.
RUN cmake -B build \
    -DGGML_CUDA=ON \
    -DGGML_CUDA_F16=ON \
    -DLLAMA_CURL=OFF \
    -DCMAKE_CUDA_ARCHITECTURES="80;86;89;90;120" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS=-DGGML_SCHED_MAX_SPLIT_INPUTS=128 \
    -DCMAKE_CUDA_FLAGS=-DGGML_SCHED_MAX_SPLIT_INPUTS=128 \
    && cmake --build build --config Release -j$(nproc)

# --- Stage 2: Runtime ---
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=build /build/llama.cpp/build/bin/ /usr/local/lib/llama/
ENV LD_LIBRARY_PATH=/usr/local/lib/llama:${LD_LIBRARY_PATH}

RUN mkdir -p /models

EXPOSE 8001

ENTRYPOINT ["llama-server"]
